# Apache Rewrite Rules for Next.js Static Export on Hostinger
# Frontend: https://mbktechnologies.info
# Backend API: https://mbk-project-spf5.onrender.com

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ── Dynamic [id] route shells (static export placeholder pages) ──────────────

  # /dashboard/companies/[id]/courses/[courseId]/colleges/[collegeId]/
  RewriteRule ^dashboard/companies/[^/]+/courses/[^/]+/colleges/[^/]+/?$ /dashboard/companies/1/courses/1/colleges/1/index.html [L]

  # /dashboard/companies/[id]/courses/[courseId]/
  RewriteRule ^dashboard/companies/[^/]+/courses/[^/]+/?$ /dashboard/companies/1/courses/1/index.html [L]

  # /dashboard/companies/college/[id]/department/[departmentName]/
  RewriteRule ^dashboard/companies/college/[^/]+/department/[^/]+/?$ /dashboard/companies/college/1/department/1/index.html [L]

  # /dashboard/companies/college/[id]/
  RewriteRule ^dashboard/companies/college/[^/]+/?$ /dashboard/companies/college/1/index.html [L]

  # /dashboard/companies/[id]/  (must come AFTER the more-specific routes above)
  RewriteRule ^dashboard/companies/[^/]+/?$ /dashboard/companies/1/index.html [L]

  # /dashboard/trainers/[id]/
  RewriteRule ^dashboard/trainers/[^/]+/?$ /dashboard/trainers/1/index.html [L]

  # /dashboard/complaints/[id]/
  RewriteRule ^dashboard/complaints/[^/]+/?$ /dashboard/complaints/1/index.html [L]

  # /dashboard/colleges/[id]/
  RewriteRule ^dashboard/colleges/[^/]+/?$ /dashboard/colleges/1/index.html [L]

  # /dashboard/cities/[id]/
  RewriteRule ^dashboard/cities/[^/]+/?$ /dashboard/cities/1/index.html [L]

  # /spoc/colleges/[id]/
  RewriteRule ^spoc/colleges/[^/]+/?$ /spoc/colleges/1/index.html [L]

  # ─────────────────────────────────────────────────────────────────────────────

  # For paths that have a trailing slash and an index.html exists, serve it
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Fallback: serve index.html for all unmatched routes (SPA client-side routing)
  RewriteRule ^ /index.html [L]
</IfModule>

# ─── Security Headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# ─── Caching ─────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ─── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
